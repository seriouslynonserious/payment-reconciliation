              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{processed_event}}\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"{{success_tx}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-01T10:05:00Z\"\n}",
