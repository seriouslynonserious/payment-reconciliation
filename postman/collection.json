  "info": {
    "_postman_id": "6510a36d-5dea-449c-9359-b38082e51982",
    "name": "Setu Payment Reconciliation \u2014 API Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the entire collection in order. The first request creates fresh IDs and a dedicated demo merchant. Each run adds four synthetic transactions and eight unique events; existing data is preserved. Set base_url to your local or public API (no trailing slash). Covers all five required APIs plus health, validation, idempotency, conflicts and reconciliation. No authentication is configured for this synthetic assignment demo."
  },
