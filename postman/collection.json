  "item": [
    {
      "name": "01 \u2014 Start a fresh demo run",
      "item": [
        {
          "name": "Health and initialize demo variables",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Run this request first. It generates new IDs without deleting any data.",
                  "pm.collectionVariables.set(\"merchant_id\", \"postman_\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"success_tx\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"failed_tx\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"overdue_tx\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"conflict_tx\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"missing_tx\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"initiated_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"processed_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"settled_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"failed_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"failed_settled_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"overdue_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"conflict_processed_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"conflict_failed_event\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"identity_event\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Database ready\", () => { pm.expect(body.status).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 \u2014 Successful payment and idempotency",
      "item": [
        {
          "name": "Initiate payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{initiated_event}}\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"{{success_tx}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_name\": \"{{merchant_name}}\",\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-01-01T10:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Expected transaction state\", () => { pm.expect(body.payment_status).to.eql(\"initiated\"); pm.expect(body.settlement_status).to.eql(\"pending\"); });",
                  "pm.test(\"New event\", () => { pm.expect(body.duplicate).to.eql(false); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Process payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
